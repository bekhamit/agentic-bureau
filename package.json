{
  "name": "agentic-bureau",
  "version": "1.0.0",
  "description": "An MCP server that enables AI agents to make payments via Locus. Acts as an agentic payment bureau for autonomous financial transactions.",
  "main": "src/server.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/bekhamit/agentic-bureau.git"
  },
  "scripts": {
    "start": "tsx index.ts",
    "dev": "tsx watch index.ts",
    "server": "tsx src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "locus",
    "payments",
    "ai-agents",
    "autonomous-agents",
