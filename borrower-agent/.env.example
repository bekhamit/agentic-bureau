# Borrower Agent Configuration

# Your Anthropic API key (required)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Your wallet address to receive payments (required)
# This should be your personal wallet address starting with 0x
BORROWER_WALLET_ADDRESS=0xYourWalletAddressHere

# Agentic Bureau MCP Server URL (required)
# Local development: http://localhost:8080/mcp
# Railway production: https://your-app-name.railway.app/mcp
BUREAU_MCP_URL=http://localhost:8080/mcp
