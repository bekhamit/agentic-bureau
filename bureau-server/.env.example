# Bureau Server Configuration

# Your Locus API key (required)
# Get from: https://app.paywithlocus.com
LOCUS_API_KEY=your_locus_api_key_here

# Your Anthropic API key (required)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Database Configuration (required for credit scoring and loan management)
# Get from: https://app.supabase.com
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Server port (defaults to 8080)
# PORT=8080
